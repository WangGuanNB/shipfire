  "faq": {
    "name": "faq",
    "label": "FAQ",
    "title": "Frequently Asked Questions",
    "description": "Common questions about credits and AI video generation.",
    "items": [
      {
        "title": "How are credits used?",
        "description": "Each generation costs credits based on the model, resolution and duration. Basic 480p/5s starts at 20 credits. The Create button shows the exact cost before you submit."
      },
      {
        "title": "Do failed generations refund credits?",
        "description": "Yes. When a task fails, reserved credits are released back to your balance automatically."
      },
      {
        "title": "Can I upgrade or cancel?",
        "description": "Anytime. Upgrade or cancel from your account. Subscriptions run through the end of the billing period with no long-term contract."
      },
      {
        "title": "Can I get a refund?",
        "description": "We currently do not offer refunds. Review plan details before purchasing. For exceptional cases, contact support@shipfire.app."
      },
      {
        "title": "What models are included?",
        "description": "All plans include Basic (Seedance 1.5 Pro), Seedance 2 Fast, Seedance 2 and Wan 2.6. Pro-tier models cost more credits per generation."
      },
      {
        "title": "Can I get help using the product?",
        "description": "Contact support@shipfire.app. Premium users receive priority support."
      }
    ]
  }
