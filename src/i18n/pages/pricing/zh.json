  "faq": {
    "name": "faq",
    "label": "常见问题",
    "title": "常见问题解答",
    "description": "关于积分与 AI 视频生成的常见问题。",
    "items": [
      {
        "title": "积分怎么扣？",
        "description": "每次生成按模型、分辨率、时长计费。Basic 480p/5 秒起价 20 积分。Create 按钮会在提交前显示准确消耗。"
      },
      {
        "title": "生成失败会退积分吗？",
        "description": "会。任务失败时，已预留的积分会自动退回余额。"
      },
      {
        "title": "可以升级或取消吗？",
        "description": "随时可以在账户中升级或取消。订阅在当前计费周期结束后停止，无长期合约。"
      },
      {
        "title": "可以退款吗？",
        "description": "目前不提供退款。购买前请仔细查看套餐详情。特殊情况请联系 support@shipfire.app。"
      },
      {
        "title": "包含哪些模型？",
        "description": "所有套餐均可使用 Basic（Seedance 1.5 Pro）、Seedance 2 Fast、Seedance 2 和 Wan 2.6。Pro 档模型每次消耗更多积分。"
      },
      {
        "title": "可以获得使用帮助吗？",
        "description": "请联系 support@shipfire.app。高级版用户享有优先支持。"
      }
    ]
  }
